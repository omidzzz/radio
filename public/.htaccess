# ─────────────────────────────────────────────
# Static HTML Export (`next export`) — Apache/cPanel
# Deploy the entire `out/` folder — including this hidden .htaccess file —
# to the domain's document root. Do NOT point this at a Node.js backend.
# ─────────────────────────────────────────────
# Force UTF-8 charset (fixes Persian/Arabic mojibake)
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .json .xml .rss .txt
</IfModule>

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  Options +FollowSymLinks -Indexes

  # Force www → non-www (uncomment one of the two redirect blocks below)
  # Option A: Redirect www to non-www
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Option B: Redirect non-www to www
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # Force HTTPS (uncomment when SSL is active)
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Strip locale prefix (/en or /fa) for static export — serve underlying page
  RewriteRule ^en/(.*)$ /$1 [L]
  RewriteRule ^en$ / [L]
  RewriteRule ^fa/(.*)$ /$1 [L]
  RewriteRule ^fa$ / [L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # No Node.js backend in static export → block API routes explicitly
  RewriteRule ^api/ - [R=404,L]

  # Favicon (actual file lives at /images/icon-512.png)
  RewriteRule ^favicon\.ico$ /images/icon-512.png [L]

  # Root path → index.html
  RewriteRule ^$ /index.html [L]

  # Client-side routes fall back to index.html (Next.js renders real 404s)
  RewriteCond %{REQUEST_URI} !\.(?:css|js|jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|eot|webp|avif|json|xml|txt|html)$ [NC]
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# CORS headers (restricted - replace with your actual domain)
<IfModule mod_headers.c>
  SetEnvIf Origin "^https?://(yourdomain\.com|localhost:3000)$" CORS_ALLOWED_ORIGIN=$0
  Header set Access-Control-Allow-Origin "%{CORS_ALLOWED_ORIGIN}e" env=CORS_ALLOWED_ORIGIN
  Header set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, x-csrf-token"
  Header set Access-Control-Allow-Credentials "true"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# Limit file upload size (5MB)
LimitRequestBody 5242880

# Protect sensitive files
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Protect .env file
<Files ".env">
  Order allow,deny
  Deny from all
</Files>

# Protect database files
<FilesMatch "\.(db|sqlite|db-shm|db-wal)$">
  Order allow,deny
  Deny from all
</Files>