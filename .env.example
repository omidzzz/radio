# Admin Panel Configuration
# ⚠️ REQUIRED — Set a secure password! There is NO default password.
# If this is not set, the admin panel will fail closed.
ADMIN_PASSWORD=change-me-to-a-secure-password

# ⚠️ REQUIRED — Session signing secret. Use a random string of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-32-char-secret

# Application URL (used for generating absolute URLs, sitemap, RSS, canonical, JSON-LD)
# ⚠️ IMPORTANT: Replace with your actual domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Node Environment
NODE_ENV=production

# ─────────────────────────────────────────────
# ANALYTICS (optional — set at least one)
# ─────────────────────────────────────────────
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Plausible Analytics domain (yourdomain.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Umami Analytics website ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Umami Analytics script URL (https://analytics.example.com/script.js)
NEXT_PUBLIC_UMAMI_URL=

# ─────────────────────────────────────────────
# SEARCH ENGINE VERIFICATION (optional)
# ─────────────────────────────────────────────
# Google Search Console verification code
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Bing Webmaster Tools verification code
NEXT_PUBLIC_BING_VERIFICATION=

# Database Configuration (SQLite - no changes needed for ParsWebServer)
# Database is stored in /data/site.db

# File Upload Configuration
# Uploads are stored in /public/uploads/
# Maximum file size: 5MB (configured in API route)
# Allowed types: images (jpeg, png, gif, webp, svg), PDF, text