{
  "name": "radiotherapist-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "blog:import": "node --experimental-strip-types scripts/import-blog.ts",
    "blog:sync": "node --experimental-strip-types scripts/import-blog.ts --all",
    "blog:check": "node --experimental-strip-types scripts/import-blog.ts --all --check",
    "blog:verify-build": "node scripts/verify-blog-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "backup": "node scripts/backup-db.js",
    "icons": "node scripts/generate-icons.js",
    "ping:sitemap": "node scripts/ping-sitemap.js",
    "test:lighthouse": "node scripts/lighthouse-runner.js",
    "test:lighthouse:ci": "lhci collect && lhci assert",
    "deploy": "next build && node scripts/zip-output.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^15.5.28",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.16.1",
    "cssnano": "^9.9.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.32",
    "serve": "^14.2.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "sharp@0.34.5": true
  }
}
